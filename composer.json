{
    "name": "empiricompany/maho-nexi-xpaybuild",
    "description": "Nexi XPay Build embedded card payment for Maho",
    "license": "OSL-3.0",
    "type": "maho-module",
    "keywords": [
        "maho",
        "nexi",
        "xpay",
        "payment",
        "gateway"
    ],
    "require": {
        "php": ">=8.3 <8.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "mahocommerce/maho": "*",
        "mahocommerce/maho-phpstan-plugin": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "phpstan/phpstan-strict-rules": "*",
        "rector/rector": "*"
    },
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyze",
        "rector": "vendor/bin/rector --dry-run",
        "check": [
            "@cs",
            "@phpstan",
            "@rector"
        ]
    },
    "extra": {
        "maho-module-dir": "app/code/community/Nexi/XPayBuild"
    }
}
