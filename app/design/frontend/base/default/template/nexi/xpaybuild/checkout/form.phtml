/** @var Nexi_XPayBuild_Block_Form_Build $this */
/** @var Nexi_XPayBuild_Helper_SavedCard $_helperSavedCard */
$_helperSavedCard = Mage::helper('nexi_xpaybuild/savedCard');
$_hasSavedCards = $this->isOneclickEnabled() && count($this->getSavedCards()) > 0;
$_preSelectedCardId = 0;
?>
<div id="payment_form_nexi_xpaybuild" class="nexi-payment-form" style="display:none;"
     data-method-code="<?= $this->escapeHtml($this->getMethodCode()) ?>"
     data-environment="<?= $this->escapeHtml($this->getEnvironment()) ?>"
     data-card-form-style="<?= $this->escapeHtml($this->getCardFormStyle()) ?>"
     data-get-payment-data-url="<?= $this->escapeUrl($this->getPaymentDataUrl()) ?>"
     data-place-order-url="<?= $this->escapeUrl($this->getPlaceOrderUrl()) ?>">

    <div id="nexi-error" class="nexi-error-message validation-advice" style="display:none;"></div>

    <div id="nexi-saved-cards" class="nexi-saved-cards">
        <?php if ($_hasSavedCards): ?>
        <p><strong><?= $this->__('Pay with a saved card:') ?></strong></p>
        <?php foreach ($this->getSavedCards() as $card): ?>
        <label class="nexi-card-option">
            <input type="radio"
                name="nexi_saved_card"
                value="<?= (int) $card->getId() ?>"
                <?php if (!$_preSelectedCardId): echo 'checked'; $_preSelectedCardId = (int) $card->getId(); endif ?> />
            <img src="<?= $this->getSkinUrl($_helperSavedCard->getCardBrandIcon((string) $card->getBrand())) ?>"
                 alt="<?= $this->escapeHtml($card->getBrand()) ?>"
                 width="36" style="vertical-align:middle; margin-right:4px; float:left; max-height:24px; width:auto;" />
            <?= $this->escapeHtml($card->getMaskedPan()) ?>
            (<?= $this->__('Exp.') ?> <?= $this->escapeHtml((string) $card->getExpiryMonth()) ?>/<?= $this->escapeHtml((string) $card->getExpiryYear()) ?>)
        </label>
        <?php endforeach ?>

        <div id="xpay-oneclick-hidden" class="nexi-build-field nexi-build-field__card"></div>
        <?php endif ?>

        <label class="nexi-card-option" <?php if (!$_hasSavedCards): echo 'style="display:none"'; endif ?>>
            <input type="radio" name="nexi_saved_card" value="0" <?php if (!$_hasSavedCards): echo 'checked'; endif ?>/>
            <?= $this->__('Use a new card') ?>
        </label>
    </div>

    <div id="nexi-gateway-container">

        <div class="nexi-accepted-brands"<?php if ($_hasSavedCards): ?> style="display:none;"<?php endif; ?>>
            <span class="nexi-accepted-brands-label"><?= $this->__('Accepted credit cards:') ?></span>
            <div class="nexi-brands-list">
                <?php foreach ($this->getCardBrandLogos() as $brand): ?>
                <img src="<?= $this->escapeHtml($brand['image']) ?>"
                     alt="<?= $this->escapeHtml($brand['alt']) ?>"
                     class="nexi-brand-logo"
                     onerror="this.style.display='none'" />
                <?php endforeach ?>
            </div>
        </div>

        <div class="nexi-card-form"<?php if ($_hasSavedCards): ?> style="display:none;"<?php endif; ?>>
            <p class="nexi-card-form-label"><?= $this->__('Enter your card details:') ?></p>

            <?php if ($this->getCardFormStyle() === Nexi_XPayBuild_Model_Api_XpayClient::XPAY_CARD_FORM_STYLE_UNIFIED): ?>

            <div class="nexi-field-wrapper">
                <div id="xpay-pan-expiry-cvv-card" class="nexi-build-field nexi-build-field__card"></div>
            </div>

            <?php else: ?>

            <div class="nexi-field-wrapper nexi-field-pan">
                <div id="xpay-pan" class="nexi-build-field nexi-build-field__pan"></div>
                <span class="nexi-field-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" focusable="false" aria-hidden="true"><path d="M2.5 7c0-.966.784-1.75 1.75-1.75h5.5c.966 0 1.75.784 1.75 1.75v3.5a1.75 1.75 0 0 1-1.75 1.75h-5.5A1.75 1.75 0 0 1 2.5 10.5zm7-1.75V4.22c0-1.364-1.12-2.47-2.5-2.47S4.5 2.856 4.5 4.22v1.03"/></svg>
                </span>
            </div>

            <div class="nexi-card-row">
                <div class="nexi-field-wrapper">
                    <div id="xpay-expiry" class="nexi-build-field nexi-build-field__expiry"></div>
                </div>
                <div class="nexi-field-wrapper nexi-field-cvv">
                    <div id="xpay-cvv" class="nexi-build-field nexi-build-field__cvv"></div>
                    <span class="nexi-cvv-icon" tabindex="0" role="button" aria-label="<?= $this->__('CVV info') ?>">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" focusable="false" aria-hidden="true"><g clip-path="url(#questionCircle_svg__a)"><circle cx="7" cy="7" r="5.5"/><path stroke-linejoin="round" d="M6.99 10.24h.02v.02h-.02z"/><path stroke-linecap="round" d="M5.5 5.25a1.5 1.5 0 1 1 2.428 1.179C7.494 6.77 7 7.198 7 7.75"/></g><defs><clipPath id="questionCircle_svg__a"><path fill="#fff" d="M0 0h14v14H0z"/></clipPath></defs></svg>
                        <span class="nexi-cvv-tooltip"><?= $this->__('The 3-digit security code usually found on the back of your card. American Express cards have a 4-digit code on the front.') ?></span>
                    </span>
                </div>
            </div>
            <?php endif ?>

        </div>

        <div class="nexi-pci-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="1.4em" height="1.4em" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m18,8l-1,0l0,-2c0,-2.76 -2.24,-5 -5,-5s-5,2.24 -5,5l0,2l-1,0c-1.1,0 -2,0.9 -2,2l0,10c0,1.1 0.9,2 2,2l12,0c1.1,0 2,-0.9 2,-2l0,-10c0,-1.1 -0.9,-2 -2,-2l0,-10c0,-1.1 -0.9,-2 -2,-2zm-6,9c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2s2,0.9 2,2s-0.9,2 -2,2zm3.1,-9l-6.2,0l0,-2c0,-1.71 1.39,-3.1 3.1,-3.1c1.71,0 3.1,0.92125 3.1,2.84372l0,-0.78122l0,3.0375z"/>
            </svg>
            <small class="nexi-pci-badge-text"><?= $this->__('Your card data is protected using the PCI DSS v3.2 security standard.') ?></small>
        </div>

        <div class="nexi-footer-row">
            <div id="nexi-save-card-container" class="nexi-save-card"<?php if ($_hasSavedCards): ?> style="display:none;"<?php endif; ?>>
                <?php if ($this->isOneclickEnabled() && $this->isCustomerLoggedIn()): ?>
                <label>
                    <input type="checkbox" id="nexi-save-card" name="payment[save_card]" value="1" />
                    <?= $this->__('Save this card for future purchases') ?>
                </label>
                <?php endif ?>
            </div>
            <div class="nexi-powered-by">
                <img src="<?= $this->escapeHtml($this->getNexiLogoUrl()) ?>"
                     alt="Nexi"
                     class="nexi-logo-powered"
                     onerror="this.style.display='none'" />
            </div>
        </div>

    </div>

    <input type="hidden" id="nexi-saved-card-id" name="payment[saved_card_id]" value="<?= (int) $_preSelectedCardId ?>" />

</div>
